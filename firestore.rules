rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function signedInAs(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function ownsNewEvent() {
      return signedIn()
        && request.resource.data.hostId == request.auth.uid
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.rsvps[request.auth.uid] == 'going'
        && request.resource.data.attendeeCount == 1
        && request.resource.data.goingCount == 1;
    }

    function ownershipIsUnchanged() {
      return request.resource.data.hostId == resource.data.hostId
        && request.resource.data.ownerId == resource.data.ownerId;
    }

    // Guests may only change their own entry in `rsvps` (status) and in
    // `guests` (their public name/photo card shown on the guest list).
    function changesOnlyOwnRsvp() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['rsvps', 'guests'])
        && request.resource.data.rsvps.diff(resource.data.rsvps)
          .affectedKeys().hasOnly([request.auth.uid])
        && request.resource.data.get('guests', {})
          .diff(resource.data.get('guests', {}))
          .affectedKeys().hasOnly([request.auth.uid]);
    }

    function aggregatesAreUnchanged() {
      return request.resource.data.attendeeCount == resource.data.attendeeCount
        && request.resource.data.goingCount == resource.data.goingCount;
    }

    match /events/{eventId} {
      // Invite links (`/e/{eventId}`) are the access token: anyone with the id
      // may fetch that one document (Vercel event page). Listing still requires
      // a signed-in app session.
      allow get: if true;
      allow list: if signedIn();
      allow create: if ownsNewEvent();
      allow update: if signedIn()
        && ownershipIsUnchanged()
        && aggregatesAreUnchanged()
        && (
          resource.data.ownerId == request.auth.uid
          || changesOnlyOwnRsvp()
        );
      // Owners can delete anytime; anyone signed in may clean up an event
      // that has already ended (the app purges ended events on load).
      allow delete: if signedIn()
        && (
          resource.data.ownerId == request.auth.uid
          || resource.data.endAt < request.time.toMillis()
        );
    }

    match /gameSessions/{sessionId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.hostId == request.auth.uid;
      allow update: if signedIn()
        && request.auth.uid == resource.data.hostId
        && request.resource.data.gameId == resource.data.gameId
        && request.resource.data.code == resource.data.code
        && request.resource.data.hostId == resource.data.hostId;
      allow delete: if signedIn()
        && resource.data.hostId == request.auth.uid;

      match /playerActions/{actionId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.id == actionId
          && request.resource.data.playerId == request.auth.uid
          && request.resource.data.createdAt is int;
        allow update, delete: if false;
      }
    }

    match /games/{gameId} {
      allow read: if signedIn();
      allow write: if false;

      match /{document=**} {
        allow read: if signedIn();
        allow write: if false;
      }
    }

    match /users/{uid} {
      allow read, write: if signedInAs(uid);

      // Anonymous Firebase Auth users have a real request.auth.uid and receive
      // the same per-user draft access as linked Google/Apple accounts.
      match /drafts/{draftId} {
        allow read, create, update, delete: if signedInAs(uid);
      }

      match /notifications/{notificationId} {
        allow read: if signedInAs(uid);
        allow update: if signedInAs(uid)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['read']);
        allow create, delete: if false;
      }

      match /meta/{documentId} {
        allow read, create, update, delete: if signedInAs(uid);
      }

      match /devices/{deviceId} {
        allow read, create, update, delete: if signedInAs(uid);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
